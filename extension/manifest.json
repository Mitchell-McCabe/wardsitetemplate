{
  "manifest_version": 3,
  "name": "Ward Sync V2",
  "version": "2.0.3",
  "description": "Import ward reports into Leaders and send reviewed Sunday check-ins to LCR.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://lcr.churchofjesuschrist.org/*",
    "https://ward.example.invalid/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ward Sync V2",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "launch.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
